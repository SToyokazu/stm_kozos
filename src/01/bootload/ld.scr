OUTPUT_ARCH(arm)
ENTRY(start)

SECTIONS
{
    . = 0x08000000;

    .vectors : {
        KEEP(*vector.o(.data))
    }

    .text : {
        *(.text)
    }

    .rodata : {
        *(.strings)
        *(.rodata)
        *(.rodata.*)
    }

    . = 0x20000000;
    
    .data : {
        *(.data)
    }

    .bss : {
        *(.bss)
        *(COMMON)
    }
}
